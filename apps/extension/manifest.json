{
  "manifest_version": 3,
  "name": "AI File Relay",
  "version": "0.2.0",
  "description": "Lets AI apps put files into web pages and get downloads back, with your approval.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI File Relay"
  }
}
