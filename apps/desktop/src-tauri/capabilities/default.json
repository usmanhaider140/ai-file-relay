{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own windows may do",
  "windows": [
    "main",
    "approval"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart"
  ]
}
