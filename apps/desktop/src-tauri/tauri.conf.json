{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI File Relay",
  "version": "0.3.0",
  "identifier": "io.github.usmanhaider140.ai-file-relay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "beforeBuildCommand": "npm run sidecar && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI File Relay",
        "url": "index.html",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false
      },
      {
        "label": "approval",
        "title": "AI File Relay: approve transfer",
        "url": "index.html#approval",
        "width": 460,
        "height": 360,
        "resizable": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Lets AI apps move files into and out of web pages, with your approval",
    "longDescription": "AI File Relay is the hub between your AI apps (Claude, Cursor and others) and your browser. It lets them put files into web pages and get downloads back, only from folders you allow, and only after you approve.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/relay-mcp"]
  }
}
